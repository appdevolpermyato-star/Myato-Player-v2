# YOUTUBE_API_KEY: Optional API key for YouTube Data API v3.
# Configured via the Secrets panel in AI Studio UI.
# If omitted, YouTube oEmbed fallback will be used for single videos.
YOUTUBE_API_KEY=MY_YOUTUBE_API_KEY

# JAMENDO_CLIENT_ID: Required Client ID for Jamendo API v3.0.
# Get one at https://developer.jamendo.com/
JAMENDO_CLIENT_ID=MY_JAMENDO_CLIENT_ID


